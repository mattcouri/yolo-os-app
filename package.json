{
  "name": "yolo-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc --noEmit && vite build --minify terser",
    "build:production": "tsc --noEmit && vite build --mode production --minify terser",
